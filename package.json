{
  "name": "proco-pio-express",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "vercel-build": "npm run prisma:generate && npm run backend:build && npm run build",
    "preview": "vite preview",
    "format": "oxfmt",
    "backend:dev": "tsx watch backend/src/server.ts",
    "backend:typecheck": "tsc -p backend/tsconfig.json --noEmit",
    "backend:build": "tsc -p backend/tsconfig.json",
    "prisma:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema backend/prisma/schema.prisma",
    "prisma:migrate:status": "prisma migrate status --schema backend/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema backend/prisma/schema.prisma",
    "prisma:seed": "tsx backend/prisma/seed.ts",
    "intelligence:test-seed": "tsx backend/prisma/intelligence-test-seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "read-excel-file": "^9.3.10",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "oxfmt": "^0.2.0",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
