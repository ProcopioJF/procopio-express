# O mapa padrão usa OpenStreetMap e não exige chave.
VITE_GOOGLE_MAPS_API_KEY=
VITE_API_URL=/api/v1
VITE_WHATSAPP_NUMBER=5532999999999
# Local development/migrations use a direct PostgreSQL URL. Vercel functions
# must use the Supabase Transaction pooler URL with pgbouncer=true (see README).
DATABASE_URL=postgresql://postgres:SUA_SENHA@db.SEU_PROJETO.supabase.co:5432/postgres?schema=public
JWT_SECRET=gere-uma-chave-secreta-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=8h
NODE_ENV=development
CORS_ORIGINS=http://localhost:8443
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OPERATIONS_NUMBER=5532999999999
WHATSAPP_AUTO_SEND=false
WHATSAPP_TEMPLATE_NAME=novo_pedido
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
# Required only if the Meta webhook will receive incoming events.
WHATSAPP_VERIFY_TOKEN=defina-um-token-de-verificacao
WHATSAPP_APP_SECRET=
# Base de um endpoint de roteamento compatível com OSRM, ex.: https://servidor/route/v1/driving
ROUTING_API_URL=
# O cálculo por KM é opcional e desativado por padrão; "Consultar valor" é o comportamento principal.
PER_KM_PRICING_ENABLED=false
# A variável Google Maps é opcional e não é necessária para o mapa do MVP.
